# Mentos backend — copy to .env and fill in real values.
# Never commit .env.

# --- Server ---
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
UVICORN_RELOAD=false

# --- Hugging Face (keyframes, slim sqlite, Qdrant snapshot) ---
HF_TOKEN=
HF_TOKEN_WRITE=
HF_REPO_ID=htNghiaaa/aic26-lowres-keyframes
HF_KEYFRAME_PREFIX=datav3
HF_DB_PREFIX=db_v2
KEYFRAME_SOURCE=hf
PREPARE_LOCAL_DATA=true
PREPARE_ELASTICSEARCH=true

# --- Local paths (created at runtime; not in git) ---
KEYFRAME_LOCAL_DIR=./data/keyframes
DB_MOUNT_DIR=./data/db_mounts
SNAPSHOT_DIR=./data/qdrant_snapshots
MODEL_CACHE_DIR=./data/model_cache
LOCAL_INDEX_DIR=./data/local_index
VIDEO_URLS_CSV=./urls.csv
CCTV_CAMS_PATH=./data/cctv/cams.json
CCTV_HIRES_CACHE=./data/cctv_hires

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=siglip2_keyframes_final
QDRANT_SNAPSHOT_FILENAME=qdrant_vectorstore_siglip2_v3/qdrant.snapshot
AUTO_RESTORE_SNAPSHOT=true
USE_LOCAL_INDEX=auto

# --- Visual encoder ---
MODEL_ID=google/siglip2-so400m-patch14-384
TORCH_COMPILE=false

# --- Elasticsearch (OCR / ASR / OD / enrichment) ---
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=ocr_keyframes
ELASTICSEARCH_ASR_INDEX=asr_segments
ELASTICSEARCH_OD_INDEX=od_entities
ELASTICSEARCH_ENRICHMENT_INDEX=enrichment_keyframes
START_ELASTICSEARCH=true
PREPARE_OCR_INDEX=true
PREPARE_ASR_INDEX=true
PREPARE_OD_INDEX=true
PREPARE_ENRICHMENT_INDEX=true
ES_REINDEX=false

# --- LLM (query translate / temporal event split) ---
OPENAI_API_KEY=
OPEN_AI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=none
GROQ_API_KEY=

# --- Optional S3 (only if KEYFRAME_SOURCE is not hf) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
S3_URL=
KEYFRAME_BUCKET=s3://your-bucket/aic2026/keyframes/
DATABASE_BUCKET=frame_db
FRAME_DB_SHARDS=
SKIP_DB_MOUNT=true
PRESIGN_EXPIRES_SECONDS=3600

# --- Bunny Stream (CCTV / hosted video playback) ---
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=

# --- Contest speech / screen OCR ---
ASR_WHISPER_MODEL=vinai/PhoWhisper-medium

# --- Runtime flags ---
DEFAULT_FPS=25
FRAME_JPEG_RAM_MAX=4096
FRAME_JPEG_DISK_CACHE=true
QUALITY_FILTER_WORKERS=8
CADDY_DOMAIN=localhost
