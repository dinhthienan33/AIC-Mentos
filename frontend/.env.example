# Create React App inlines REACT_APP_* values at build / start time.
# Copy this file to .env and fill in values. Do not commit .env.

# Mentos FastAPI origin (no trailing slash). Either name works; API_URL is tried first.
# Example: http://localhost:8000
REACT_APP_API_URL=
REACT_APP_BACKEND_ORIGIN=

# Optional default DRES server shown in the submit bar. Users can still edit it in the UI.
REACT_APP_DRES_URL=

# Dev proxy only (src/setupProxy.js). Used by `npm start` when the app calls same-origin paths.
# Falls back to REACT_APP_API_URL, then REACT_APP_BACKEND_ORIGIN, then http://localhost:8000.
BACKEND_URL=
